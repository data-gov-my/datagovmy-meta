{
    "title_en": "Annual Landings of Marine Fish by State & Species",
    "title_ms": "Pendaratan Ikan Laut Tahunan mengikut Negeri & Spesis",
    "title_sort": 220,
    "description_en": "Annual landings of marine fish by state, coast and species.",
    "description_ms": "Pendaratan ikan laut tahunan mengikut negeri, pantai dan spesis.",
    "exclude_openapi": false,
    "manual_trigger": "2026-10-10 23:02:29.209651",
